{
  "manifest_version": 3,
  "name": "eolma exporter - 쿠팡,네이버페이 거래내역 추출",
  "version": "0.3.3",
  "description": "네이버페이·쿠팡 주문내역을 Excel·CSV로 내보내거나, 로그인한 eolma 계정으로 전송합니다.",
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://pay.naver.com/*",
    "https://mc.coupang.com/*",
    "https://eolma.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pay.naver.com/pc/history*"],
      "js": ["content/naverpay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mc.coupang.com/ssr/desktop/order/list*"],
      "js": ["content/coupang-collector.js", "content/coupang.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://eolma.de/*"],
      "js": ["content/eolma.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
